{
  "name": "@pegasusheavy/enginex",
  "version": "0.1.0",
  "type": "module",
  "description": "Koa-compatible HTTP server for Bun - familiar middleware API with maximum performance",
  "author": "Pegasus Heavy Industries",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PegasusHeavyIndustries/enginex.git"
  },
  "bugs": {
    "url": "https://github.com/PegasusHeavyIndustries/enginex/issues"
  },
  "homepage": "https://github.com/PegasusHeavyIndustries/enginex#readme",
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/c/PegasusHeavyIndustries"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "test": "bun test tests/",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "example": "bun run examples/hello-world.ts",
    "example:router": "bun run examples/router-example.ts",
    "bench": "bun run benchmarks/run.ts",
    "bench:enginex": "bun run benchmarks/enginex-server.ts",
    "bench:koa": "bun run benchmarks/koa-server.ts",
    "prepublishOnly": "bun run build",
    "version": "bun run build && git add -A",
    "prepare": "husky"
  },
  "keywords": [
    "bun",
    "http",
    "koa",
    "koa-compatible",
    "server",
    "framework",
    "web",
    "api",
    "rest",
    "restful",
    "router",
    "routing",
    "middleware",
    "async",
    "await",
    "typescript",
    "performance",
    "fast",
    "lightweight",
    "microservice",
    "backend",
    "nodejs-alternative",
    "context",
    "onion-model",
    "cors",
    "logger",
    "body-parser",
    "error-handler"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@koa/router": "^15.1.1",
    "@types/koa": "^3.0.1",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-compose": "^3.2.9",
    "@types/koa-compress": "^4.0.7",
    "@types/koa-conditional-get": "^2.0.4",
    "@types/koa-etag": "^3.0.4",
    "@types/koa-response-time": "^2.1.5",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "autocannon": "^8.0.0",
    "bun-types": "latest",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "koa": "^3.1.1",
    "koa-bodyparser": "^4.4.1",
    "koa-compose": "^4.1.0",
    "koa-compress": "^5.1.1",
    "koa-conditional-get": "^3.0.0",
    "koa-etag": "^5.0.0",
    "koa-response-time": "^2.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  }
}
